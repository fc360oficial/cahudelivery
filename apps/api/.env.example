# Autenticação
JWT_SECRET=

# API
PORT=
PUBLIC_URL=

# Site de vendas por tenant: SITE_URL_<SLUG EM MAIÚSCULAS> (ex.: SITE_URL_CAHU=https://loja.cahu.com.br).
# Pagamento com cartão iniciado pelo site (X-Canal: site) volta do 3DS para <SITE_URL>/conta/pedidos/<id>.
# Vazia: a volta mostra a página do app ("volte ao aplicativo").
SITE_URL_CAHU=

# Workers e recursos opcionais
OUTBOX_DESLIGADO=
MUNICIPIOS_DESLIGADO=
GEOCODIFICACAO_DESLIGADA=
PAGAMENTOS_DESLIGADO=
